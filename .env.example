# ==============================================================================
# LLM-EduAttackGraph — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application ---
APP_ENV=development        # development | production | demo
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- Database ---
# PostgreSQL for production, SQLite for development
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/llm_edu_attackgraph
# DATABASE_URL=sqlite+aiosqlite:///./llm_edu_attackgraph.db

# --- FAISS Vector Store ---
FAISS_INDEX_PATH=./data/indexes/faiss_index.bin
FAISS_METADATA_PATH=./data/indexes/faiss_metadata.json

# --- Knowledge Base ---
KNOWLEDGE_BASE_PATH=./rag/data/processed
KNOWLEDGE_BASE_SOURCE=awesome-poc   # awesome-poc | custom
AWESOME_POC_REPO=https://github.com/Threekiii/Awesome-POC.git
AWESOME_POC_LOCAL_PATH=./rag/data/raw/awesome-poc

# --- Embedding Model ---
# Paper specifies: BAAI/bge-small-zh
# Implementation default: BAAI/bge-m3 (multilingual)
# Options: BAAI/bge-m3 | BAAI/bge-small-zh | BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu    # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32

# --- RAG Configuration ---
# Paper: similarity_threshold = 0.6 (Algorithm 2, line 4)
# "based on practical experience and preliminary evaluation of semantic space"
SIMILARITY_THRESHOLD=0.60
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- LLM Provider ---
# Primary: deepseek (paper's choice)
# Alternatives: groq | nvidia | openai | mock
LLM_PROVIDER=deepseek

# DeepSeek (paper's LLM)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.1

# Groq (free tier, fast inference)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (free credits)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# OpenAI (API credits)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Authorization & Safety ---
# Mode: allowlist (strict) | lab (allow private IP ranges)
AUTHORIZED_TARGET_MODE=allowlist
# Comma-separated allowlist of authorized targets
TARGET_ALLOWLIST=localhost,127.0.0.1,::1
# Maximum concurrent scans
MAX_CONCURRENT_SCANS=3
# Scan timeout in seconds
SCAN_TIMEOUT=300

# --- Fingerprinting ---
# Optional: paths to the paper's .exe tools if available (Windows only)
PORT_GO_EXE_PATH=
SERVER_GO_EXE_PATH=
FINGER_EXE_PATH=
# Optional: Spark API (paper's Algorithm 1 inline vulnerability analysis)
SPARK_API_KEY=
SPARK_API_URL=

# Port scan settings
PORT_SCAN_TIMEOUT=3          # seconds per port
PORT_SCAN_THREADS=50
PORT_SCAN_RANGE=1-65535      # or specific like "80,443,8080,8443,8888"
SERVICE_BANNER_TIMEOUT=5

# --- Reports ---
REPORTS_PATH=./data/reports
REPORT_FORMATS=json,markdown  # json | markdown | html | pdf

# --- Demo Mode ---
# When APP_ENV=demo, uses synthetic data instead of real scanning
DEMO_FINGERPRINT_PATH=./rag/data/samples/demo_fingerprint.json
DEMO_KB_PATH=./rag/data/samples/demo_knowledge_base.json

# --- Prompt Templates ---
PROMPT_TEMPLATES_PATH=./llm/prompts
PROMPT_VERSION=v1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
