# ==============================================================================
# LLM-EduAttackGraph — Environment Configuration
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development        # development | production | demo
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — no setup required, tables created automatically at startup):
DATABASE_URL=sqlite+aiosqlite:///./eduattackgraph.db

# PostgreSQL (optional — supported but not required):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eduattackgraph
#
# NOTE: There are NO Alembic migrations. The schema is created with create_tables()
# at startup. If you change models, drop the DB and restart.
# Alembic migration support is on the roadmap.

# ─── Embedding Model ──────────────────────────────────────────────────────────
# Source of truth: BAAI/bge-small-en-v1.5 (English, 384-dim)
#
# Paper original : BAAI/bge-small-zh (Chinese-only, 512-dim)
# This implementation: bge-small-en-v1.5 (English; Awesome-POC corpus is EN-dominant)
# Multilingual option: BAAI/bge-m3 (supports 100+ languages, 1024-dim, heavier)
#
# IMPORTANT: The EMBEDDING_MODEL here must match what was used to build the FAISS index.
# If you change this value, you MUST rebuild the FAISS index (scripts/build_faiss_index.py).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu               # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32

# ─── RAG / FAISS ──────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./faiss_index/index.faiss
FAISS_METADATA_PATH=./faiss_index/metadata.json

# Similarity threshold — paper value is 0.60 (Algorithm 2, line 4)
# Comparison is >= (not >): scores exactly at 0.60 pass the threshold.
SIMILARITY_THRESHOLD=0.60
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ─── Knowledge Base ───────────────────────────────────────────────────────────
AWESOME_POC_LOCAL_PATH=./rag/data/raw/awesome-poc
AWESOME_POC_REPO=https://github.com/Threekiii/Awesome-POC.git

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: groq | nvidia | openai | deepseek | mock
#
# Provider status:
#   groq    — TESTED, ACTIVE (default). Free tier. Get key: console.groq.com
#   nvidia  — TESTED, ACTIVE (fallback). Free credits. Get key: build.nvidia.com
#   openai  — TESTED. Paid. gpt-4o-mini is cost-effective.
#   deepseek— SUPPORTED, NOT TESTED (paid API, paper's original LLM)
#   mock    — ALWAYS WORKS. No API key. Synthetic responses only.
#
# Default is 'groq' (working, free) — NOT 'deepseek' (paid, not configured).
LLM_PROVIDER=groq

# Groq (primary — free tier, fast inference):
GROQ_API_KEY=                          # ← Get from console.groq.com
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b

# NVIDIA NIM (fallback — free credits):
NVIDIA_API_KEY=                        # ← Get from build.nvidia.com
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-r1

# OpenAI (paid fallback):
OPENAI_API_KEY=                        # ← Get from platform.openai.com
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (paper's original LLM — paid, not configured by default):
DEEPSEEK_API_KEY=                      # ← Get from platform.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.1

# ─── Authorization & Safety ───────────────────────────────────────────────────
# Mode options:
#   localhost_only — only 127.0.0.1/localhost/::1 (safest, recommended for development)
#   allowlist      — only DB-registered + admin-authorized targets
#   lab            — allowlist + private IP ranges (192.168.x.x, 10.x.x.x)
AUTHORIZED_TARGET_MODE=localhost_only
TARGET_ALLOWLIST=localhost,127.0.0.1,::1,0.0.0.0
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT=300

# ─── Fingerprinting ───────────────────────────────────────────────────────────
PORT_SCAN_TIMEOUT=3          # seconds per port
PORT_SCAN_THREADS=50
PORT_SCAN_RANGE=80,443,8080,8443,8888,3000,3306,5432,6379,9200,27017
SERVICE_BANNER_TIMEOUT=5

# ─── Demo Mode ────────────────────────────────────────────────────────────────
# When APP_ENV=demo, synthetic data is used — no real scanning occurs
DEMO_FINGERPRINT_PATH=./demo_data/fingerprint_sample.json
DEMO_KB_PATH=./demo_data/knowledge_base_sample.json

# ─── Prompts ──────────────────────────────────────────────────────────────────
PROMPT_VERSION=v1
SYSTEM_PROMPT_PATH=./llm/prompts/system.txt
VULNERABILITY_PROMPT_PATH=./llm/prompts/vulnerability_analysis.txt

# ─── Reports ──────────────────────────────────────────────────────────────────
REPORTS_PATH=./data/reports

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
