# ============================================================
# LLM-EduAttackGraph — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ─── Database ────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./eduattackgraph.db

# PostgreSQL (optional, for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/eduattackgraph

# ─── Embedding Model ─────────────────────────────────────────
# Paper default: BAAI/bge-m3 (multilingual)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu                     # cpu | cuda | mps
# BGE_API_KEY=                           # Only if using hosted BGE API

# ─── RAG / FAISS ─────────────────────────────────────────────
FAISS_INDEX_PATH=./faiss_index/index.faiss
FAISS_METADATA_PATH=./faiss_index/metadata.json
SIMILARITY_THRESHOLD=0.60               # Paper: 0.6 threshold
TOP_K=5                                 # Top-K chunks to retrieve

# ─── LLM Provider ────────────────────────────────────────────
# Options: mock | deepseek | groq | nvidia | openai
LLM_PROVIDER=mock                       # Use 'mock' to test without API key

# DeepSeek (paper's primary LLM):
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...               # ← Get from platform.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Groq (fast inference, free tier available):
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...                  # ← Get from console.groq.com
# GROQ_MODEL=deepseek-r1-distill-llama-70b

# NVIDIA NIM (mentioned in paper):
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-...              # ← Get from build.nvidia.com
# NVIDIA_MODEL=deepseek-ai/deepseek-r1

# OpenAI (fallback):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ─── Authorization ───────────────────────────────────────────
# 'allowlist' = only registered targets in DB may be scanned
# 'localhost_only' = only localhost/127.0.0.1
# 'any' = WARNING — disabled for research/production use
AUTHORIZED_TARGET_MODE=localhost_only
ALLOWED_TARGETS=localhost,127.0.0.1,::1

# ─── Demo Mode ───────────────────────────────────────────────
DEMO_MODE=false
DEMO_FINGERPRINT_PATH=./demo_data/fingerprint_sample.json
DEMO_KB_PATH=./demo_data/knowledge_base_sample.json

# ─── Prompt ──────────────────────────────────────────────────
PROMPT_VERSION=v1
SYSTEM_PROMPT_PATH=./llm/prompts/system.txt
VULNERABILITY_PROMPT_PATH=./llm/prompts/vulnerability_analysis.txt

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
